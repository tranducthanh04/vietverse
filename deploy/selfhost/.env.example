# Vietverse self-host — mẫu cho ~/vietverse/.env (KHÔNG commit file .env thật; quyền 600).
# init.sh sao chép file này và tự sinh mọi giá trị __GENERATE__ bằng `openssl rand -hex`.
# [BẮT BUỘC] phải có giá trị trước khi chạy up.sh; [TÙY CHỌN] để trống được.
# Không dán secret thật vào repo, chat hay tài liệu.

# ----- Docker / vận hành ---------------------------------------------------------------
# Tag image vietverse/api, vietverse/web. up.sh tự ghi git short SHA vào đây.
VIETVERSE_TAG=latest
# up.sh ghi tag trước đó để rollback nhanh (giữ lại image của tag này).
VIETVERSE_PREVIOUS_TAG=
# UID/GID của user chủ ~/vietverse (init.sh ghi bằng `id -u`/`id -g`): file backup thuộc user này.
VV_UID=1000
VV_GID=1000

# ----- MongoDB (chỉ trong network vietverse_net, không publish port) -------------------
# Mật khẩu chỉ dùng chữ/số (được ghép thẳng vào MONGODB_URI, không URL-encode).
# [BẮT BUỘC] root: chỉ container mongo/mongo-init/restore dùng, API KHÔNG nhận biến này.
MONGO_ROOT_USERNAME=vietverse_root
MONGO_ROOT_PASSWORD=__GENERATE__
# [BẮT BUỘC] user ứng dụng: readWrite chỉ trên DB `vietverse` (authSource=vietverse).
# compose.yml tự ghép MONGODB_URI=mongodb://<user>:<pw>@vietverse-mongo:27017/vietverse?replicaSet=rs0&authSource=vietverse
MONGO_APP_USERNAME=vietverse_app
MONGO_APP_PASSWORD=__GENERATE__
# [BẮT BUỘC] user backup: chỉ quyền read trên DB `vietverse` (mongodump).
MONGO_BACKUP_USERNAME=vietverse_backup
MONGO_BACKUP_PASSWORD=__GENERATE__
# [TÙY CHỌN] backup hằng ngày sau giờ này (giờ VN, 0-23) và số bản daily giữ lại.
BACKUP_HOUR=2
BACKUP_KEEP=14

# ----- API (server/src/config/env.ts) ---------------------------------------------------
# Cố định cho self-host: NODE_ENV=production, PORT=5000 (nginx web + healthcheck dùng 5000).
NODE_ENV=production
PORT=5000
# [BẮT BUỘC] origin HTTPS chính xác mà trình duyệt dùng (FE + API cùng origin).
CLIENT_ORIGIN=https://vietverse.io.vn
# [TÙY CHỌN] origin HTTPS bổ sung, phân tách dấu phẩy (không cần cho www vì www redirect 301 về apex).
CLIENT_ORIGINS=
# Self-host: tin đúng 2 proxy (nginx host + nginx web) khi lấy IP cho rate limit.
# Nếu sau này thêm một proxy/CDN phía trước nginx host thì tăng thành 3.
SELF_HOSTED=1
TRUST_PROXY_HOPS=2
# [BẮT BUỘC] secret JWT mới, riêng cho máy chủ này (init.sh sinh 96 ký tự hex).
# Đổi giá trị = mọi phiên đăng nhập hiện có bị đăng xuất.
JWT_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Chỉ bật sau khi đã kiểm chứng transaction/reader theo docs/cms-operations.md.
CMS_PUBLISH_ENABLED=false
# Audio (bản thu của bé + narration nội dung) lưu trên volume vietverse_audio tại /data/audio.
# compose.yml đã đặt AUDIO_STORAGE_DIR=/data/audio; không cần khai báo ở đây.

# [TÙY CHỌN, cần cho đăng nhập Google] Web Client ID (công khai). Thêm https://vietverse.io.vn
# vào Authorized JavaScript origins trong Google Cloud Console.
GOOGLE_CLIENT_ID=

# [TÙY CHỌN, chỉ cần cho ảnh bìa CMS] Cloudinary — audio KHÔNG còn dùng Cloudinary (lưu trên đĩa).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_UPLOAD_PRESET=

# [TÙY CHỌN] PayOS: điền đủ cả ba hoặc để trống cả ba (thiếu thì checkout trả 503).
# Webhook trong PayOS Merchant Portal: https://vietverse.io.vn/api/v1/payments/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
