# Server Environment Configuration
PORT=5000
NODE_ENV=development
CMS_PUBLISH_ENABLED=false
CLIENT_ORIGIN=http://localhost:5173
# Google Identity Services Web Client ID (public identifier; never put a client secret in Vite)
GOOGLE_CLIENT_ID=

# Database Connection (MongoDB Atlas M0 or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/vietverse

# Security & JWT Tokens
JWT_SECRET=vietverse_access_token_secret_key_change_in_production_2026
JWT_REFRESH_SECRET=vietverse_refresh_token_secret_key_change_in_production_2026

# Cloudinary (Optional in dev: fallback to local/mock audio storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RECORDING_UPLOAD_PRESET=

# Default Seed Credentials
SEED_ADMIN_EMAIL=admin@vietverse.edu.vn
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_PARENT_EMAIL=phuhuynh@vietverse.edu.vn
# PayOS is optional; leave all three blank or configure the complete set.
# Paste real values only in server/.env (git-ignored), never in client/VITE_* variables.
# Production needs the same keys in the backend host's environment, then a restart/redeploy.
# Configure the webhook URL
# in the PayOS merchant portal as https://<api-domain>/api/v1/payments/webhook.
# For vietverse.io.vn: https://vietverse.io.vn/api/v1/payments/webhook (not the homepage).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
